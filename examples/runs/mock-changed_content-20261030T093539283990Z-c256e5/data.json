      "title": "费用报销管理办法 A",
      "version_date": "2026-08-01",
      "scope": "未注明",
      "chunks": [
        {
          "chunk_id": "C1",
          "text": "员工应在费用发生之日起 30 天内提交报销申请。"
        },
        {
          "chunk_id": "C2",
          "text": "本文未说明与其他报销制度的优先关系，也未注明适用部门。"
        }
      ]
    },
    {
