      "scope": "未注明",
      "chunks": [
        {
          "chunk_id": "C1",
          "text": "员工应在费用发生之日起 15 天内提交报销申请。"
        },
        {
          "chunk_id": "C2",
          "text": "本文未说明替代哪份制度，也未注明适用部门。"
        }
